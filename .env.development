# Development Environment Configuration
NODE_ENV=development

# API Configuration - using Vite proxy
VITE_API_BASE_URL=http://localhost:5173/api
VITE_OAUTH_SERVER_URL=http://localhost:5173
VITE_APP_ID=housing-app

# Maps API Configuration (Frontend Forge)
# Get your API key from: https://www.forgeapi.com
VITE_FRONTEND_FORGE_API_KEY=your_api_key_here
VITE_FRONTEND_FORGE_API_URL=https://forge.butterfly-effect.dev
